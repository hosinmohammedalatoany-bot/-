# Public URL where users open the app (required for production / HTTPS cookies)
# Example: https://app.baraa-raed.com
NEXT_PUBLIC_APP_URL=

# Expose verify/reset links in API JSON during dev or when email is not configured
VERIFY_EMAIL_IN_RESPONSE=true

# Optional: separate API base if you split frontend/backend later
# NEXT_PUBLIC_API_URL=

# Node environment
NODE_ENV=production

# Listen on all interfaces (used by npm scripts and Docker)
HOSTNAME=0.0.0.0
PORT=3000

# --- First boot: optional super-admin (only when DB has zero users) ---
# Do not commit real passwords. Set in production.env or secrets manager.
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_BRANCH=الفرع الرئيسي
# DEFAULT_ADMIN_PHONE=

# Session cookie security: set NEXT_PUBLIC_APP_URL to https://... in production
