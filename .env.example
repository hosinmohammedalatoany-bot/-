# --- Public URLs (optional) ---
# Where users open the app in the browser. On Cloudflare Tunnel the live URL is detected
# automatically; set these for official production only.
# NEXT_PUBLIC_PUBLIC_BASE_URL=https://app.powerxerp.com
# Legacy alias (same meaning):
NEXT_PUBLIC_APP_URL=

# Django REST API (Baraa Raed backend on port 8000)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Legacy alias:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Separate API host only if frontend and API are on different domains:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Expose verify/reset links in API JSON during dev or when email is not configured
VERIFY_EMAIL_IN_RESPONSE=true

# Node environment
NODE_ENV=production

# Listen on all interfaces (used by npm scripts and Docker)
HOSTNAME=0.0.0.0
PORT=3000

# Tunnel / preview (optional): PORT=4173 npm run start
# npm run tunnel — defaults to PORT=4173 for cloudflared quick tunnel

# --- First boot: optional super-admin (only when DB has zero users) ---
# Do not commit real passwords. Set in production.env or secrets manager.
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_BRANCH=الفرع الرئيسي
# DEFAULT_ADMIN_PHONE=

# Session cookies use Secure on HTTPS (including *.trycloudflare.com)
