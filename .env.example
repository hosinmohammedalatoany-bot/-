# Public URL where users open the app (required for production / tunnel)
# Example: https://app.your-domain.com or https://xxxx.trycloudflare.com
NEXT_PUBLIC_APP_URL=

# Expose verify/reset links in API JSON during dev or when email is not configured
VERIFY_EMAIL_IN_RESPONSE=true

# Optional: separate API base if you split frontend/backend later
# NEXT_PUBLIC_API_URL=

# Node environment
NODE_ENV=production

# Listen on all interfaces (used by npm scripts)
HOSTNAME=0.0.0.0
PORT=3000
