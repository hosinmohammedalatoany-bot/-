# Copy to production.env on the server (never commit production.env)
# Used by deploy/docker-compose.sh

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Official production URLs (no trailing slash)
NEXT_PUBLIC_PUBLIC_BASE_URL=https://app.powerxerp.com
NEXT_PUBLIC_APP_URL=https://app.powerxerp.com
# Only if API is on a separate host:
# NEXT_PUBLIC_API_BASE_URL=https://api.powerxerp.com

# Disable dev-only reset links in API responses
VERIFY_EMAIL_IN_RESPONSE=false

# Required in production — signs session cookies (middleware + API validation)
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars

# First boot only — create super-admin if database is empty
DEFAULT_ADMIN_NAME=مدير النظام
DEFAULT_ADMIN_EMAIL=admin@your-showroom.com
DEFAULT_ADMIN_PASSWORD=ChangeMe!2026

# Optional SMTP (for forgot-password in production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="baraa raed <noreply@your-showroom.com>"
