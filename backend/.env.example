# Django API (backend/)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL (default when USE_SQLITE is not set)
POSTGRES_DB=baraa_raed
POSTGRES_USER=baraa
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Or single URL:
# DATABASE_URL=postgresql://baraa:change-me@db:5432/baraa_raed

# Local dev without Postgres:
# USE_SQLITE=true

# CORS (Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL=true

# JWT (used from Phase 2)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# API port
API_PORT=8000
