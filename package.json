{
  "name": "baraa-raed-showroom",
  "version": "0.1.0",
  "description": "Baraa Raed Car Showroom Management System - owned, offline-first showroom ERP.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "start:preview": "next start -H 0.0.0.0 -p 4173",
    "start:prod": "npm run build && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "tunnel": "bash scripts/start-tunnel.sh",
    "check:urls": "node scripts/check-production-urls.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run check:urls && node scripts/test-register-auth.mjs && node scripts/test-session-signature.mjs",
    "test:django": "node scripts/test-django-auth.mjs",
    "test:django:organization": "node scripts/test-django-organization.mjs",
    "test:django:vehicles": "node scripts/test-django-vehicles.mjs",
    "test:django:customers": "node scripts/test-django-customers.mjs",
    "test:django:sales": "node scripts/test-django-sales.mjs",
    "test:django:printing": "node scripts/test-django-printing.mjs",
    "test:register": "node scripts/test-register-auth.mjs",
    "reset:system": "node scripts/reset-system.mjs",
    "api:check": "cd backend && python3 manage.py check",
    "api:migrate": "cd backend && python3 manage.py migrate",
    "api:dev": "cd backend && python3 manage.py runserver 0.0.0.0:8000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hosinmohammedalatoany-bot/-.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/hosinmohammedalatoany-bot/-/issues"
  },
  "homepage": "https://github.com/hosinmohammedalatoany-bot/-#readme",
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "bwip-js": "^4.11.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "^15.5.18",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.77.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
